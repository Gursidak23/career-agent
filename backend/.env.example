# Copy to .env and fill in. All settings use the CAREER_ prefix; nested keys use "__".

# --- LLM providers (fallback order: gemini -> groq -> copilot) ---
CAREER_LLM__GEMINI_API_KEY=
CAREER_LLM__GEMINI_MODEL=gemini-flash-lite-latest

CAREER_LLM__GROQ_API_KEY=
CAREER_LLM__GROQ_MODEL=llama-3.3-70b-versatile

# GitHub Copilot: last-resort fallback, billed in Copilot AI credits.
# Fine-grained PAT with the "Copilot Requests" permission. Model blank = account default.
CAREER_LLM__COPILOT_GITHUB_TOKEN=
CAREER_LLM__COPILOT_MODEL=

CAREER_LLM__TEMPERATURE=0.2
CAREER_LLM__MAX_OUTPUT_TOKENS=4096
CAREER_LLM__MAX_RETRIES=3
CAREER_LLM__REQUEST_TIMEOUT_SECONDS=60

# Efficiency controls
CAREER_LLM__RATE_PER_MINUTE=25
CAREER_LLM__CACHE_ENABLED=true
CAREER_LLM__CACHE_TTL_SECONDS=86400
CAREER_LLM__CACHE_PERSIST=true
# Candidates generated per tailoring round (best-of-N); higher = better but costlier.
CAREER_LLM__TAILOR_CANDIDATES=2

# --- Outgoing email (Phase 2 outreach). For Gmail use an App Password. ---
CAREER_SMTP__HOST=smtp.gmail.com
CAREER_SMTP__PORT=587
CAREER_SMTP__USERNAME=
CAREER_SMTP__PASSWORD=
CAREER_SMTP__FROM_NAME=
CAREER_SMTP__USE_TLS=true
CAREER_SMTP__PER_MINUTE=20

# --- Email finder (recruiter/company email discovery) ---
# Keyless providers (work with no config):
CAREER_EMAILFINDER__CRAWLER_ENABLED=true
CAREER_EMAILFINDER__PATTERN_ENABLED=true
CAREER_EMAILFINDER__CRAWLER_MAX_PAGES=6
# Verification: MX always, SMTP RCPT probe optional (port 25 is often blocked).
CAREER_EMAILFINDER__SMTP_VERIFY=true
CAREER_EMAILFINDER__VERIFY_FROM_EMAIL=verify@example.com
# Optional free-tier keyed providers (dormant until a key is set):
CAREER_EMAILFINDER__APIFY_TOKEN=
CAREER_EMAILFINDER__APIFY_ACTOR=lukaskrivka/article-extractor-smart
CAREER_EMAILFINDER__AGENTQL_API_KEY=
CAREER_EMAILFINDER__AGENTQL_ENDPOINT=https://api.agentql.com/v1/query-data
# Behavior:
CAREER_EMAILFINDER__TIMEOUT_SECONDS=20
CAREER_EMAILFINDER__STOP_ON_VERIFIED=true
CAREER_EMAILFINDER__AUTO_ENRICH=false
CAREER_EMAILFINDER__MAX_CANDIDATES=10

# --- Job sources ---
# All default sources are real, free, keyless public APIs (remotive, remoteok,
# arbeitnow, hackernews, and the "all" aggregator). No config needed.
# Optional: Apify "New Job Posts Finder" for Indian boards (Naukri / Foundit /
# Hirist / Indeed / Internshala / LinkedIn) — set a free Apify token to enable
# the `apify` source. Falls back to CAREER_EMAILFINDER__APIFY_TOKEN if unset.
CAREER_SCRAPER__APIFY_TOKEN=
CAREER_SCRAPER__APIFY_JOBS_ACTOR=spartany/new-job-posts-finder
CAREER_SCRAPER__APIFY_LOCATION=India
CAREER_SCRAPER__APIFY_MODE=deduplicated

# Company career boards (Greenhouse/Lever/Ashby public APIs, keyless). JSON list of
# "provider:token" or "provider:token=Display Name"; leave unset for the built-in list.
# CAREER_SCRAPER__COMPANY_BOARDS=["greenhouse:stripe","lever:spotify","ashby:openai=OpenAI"]

# Scheduled job fetching every N hours (0 = off), and an optional email digest of
# new jobs matching your latest resume at least DIGEST_MIN_MATCH % (needs SMTP).
CAREER_SCRAPER__AUTO_REFRESH_HOURS=0
CAREER_SCRAPER__AUTO_REFRESH_SOURCE=all
CAREER_SCRAPER__DIGEST_EMAIL=
CAREER_SCRAPER__DIGEST_MIN_MATCH=60
# Optional: add a custom Scrapy board crawler (e.g. WellFound) — see README.
CAREER_SCRAPER__PROJECT_DIR=
CAREER_SCRAPER__SPIDER=

# --- LinkedIn DM automation (Playwright; optional, off by default) ---
# Requires: pip install playwright  &&  playwright install chromium
# Then enable, and log in once via POST /api/linkedin/login (the UI "Connect" button).
CAREER_LINKEDIN__ENABLED=false
CAREER_LINKEDIN__HEADLESS=true
CAREER_LINKEDIN__USER_DATA_DIR=./data/linkedin_profile
# Reuse an installed browser (e.g. chrome / msedge); blank = bundled Chromium.
CAREER_LINKEDIN__BROWSER_CHANNEL=
CAREER_LINKEDIN__PER_MINUTE=5
CAREER_LINKEDIN__MIN_DELAY_SECONDS=4

# --- LaTeX -> PDF ---
# Path to the tectonic binary (defaults to "tectonic" on PATH).
CAREER_TECTONIC_BIN=tectonic

# --- App ---
CAREER_DB_URL=sqlite:///./career_agent.db
CAREER_CORS_ORIGINS=["http://localhost:5173"]
CAREER_DATA_DIR=./data
